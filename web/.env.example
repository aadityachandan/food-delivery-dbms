# Copy this file to .env.local and fill in the values.
# .env.local is ignored by Git, so real credentials never reach the repository.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=food_delivery

MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=food_delivery

# Secret used to sign login sessions (any long random string, 32+ characters)
JWT_SECRET=
